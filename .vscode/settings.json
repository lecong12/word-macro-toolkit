{
  "files.encoding": "windows1252",
  "files.autoGuessEncoding": true,
  "files.eol": "\\r\\n",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "files.exclude": {
    "**/.git": true,
    "**/Thumbs.db": true
  },
  "search.exclude": {
    "**/backups/**": true,
    "**/src/originals/**": true
  }
}